# Copy this file to .env.prod and fill in real values before deploying.
# NEVER commit .env.prod to git.

# PostgreSQL
POSTGRES_USER=isp
POSTGRES_PASSWORD=change-me-strong-password

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=change-me-strong-api-key

# Database URL (must match POSTGRES_USER / POSTGRES_PASSWORD above)
DATABASE_URL=postgresql://isp:change-me-strong-password@isp-db:5432/isp

# Voyage AI embedding API key
VOYAGE_API_KEY=your-voyage-api-key-here

# FastAPI
HOST=0.0.0.0
PORT=8001

# Set automatically by deploy-aws.sh — you can override if using a domain name
# PUBLIC_API_URL=http://<EC2_IP>/v1

# Secret provider — set to "aws" on EC2 to use AWS Secrets Manager
# When SECRET_PROVIDER=aws, all secrets above are fetched from Secrets Manager
# at startup and do not need to be set here. The EC2 IAM Role handles auth.
# SECRET_PROVIDER=aws
# AWS_REGION=us-east-1
