# Local development env for docker-compose.yml (isp-api service).
# Copy to backend/.env:  cp backend/.env.example backend/.env
# Non-secret values match the local Docker defaults; secrets are left blank — fill in your own.
# NEVER commit backend/.env.

# Secret provider: "env" (read from this file) | "vault" (local Docker) | "aws" (production)
SECRET_PROVIDER=env

# Uncomment and set SECRET_PROVIDER=vault to use local HashiCorp Vault
# Run ./vault/setup-secrets.sh once after docker-compose up to get the token
# VAULT_ADDR=http://isp-vault:8200
# VAULT_TOKEN=

# Uncomment and set SECRET_PROVIDER=aws to use AWS Secrets Manager
# AWS_REGION=us-east-1

# Typesense (must match --api-key in docker-compose.yml)
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=local-dev-key-change-me

# Postgres (must match isp-db in docker-compose.yml)
DATABASE_URL=postgresql://isp:isp-dev-password@isp-db:5432/isp

# Redis
REDIS_URL=redis://isp-redis:6379/0

# Embeddings / LLM
VOYAGE_API_KEY=
OPENAI_API_KEY=

# FastAPI
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ── Optional: Google Sheets connector ────────────────────────────────────────
# Only needed to ingest from Google Sheets. Raw service-account JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Optional: OAuth2 / OIDC SSO ──────────────────────────────────────────────
# Disabled by default — the API and UI work without login.
# To enable: set AUTH_ENABLED=true, fill in the OAuth values below, and set
# PUBLIC_AUTH_ENABLED=true in frontend/.env.
AUTH_ENABLED=false
# OAUTH_PROVIDER=google            # google | github | microsoft
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ALLOWED_DOMAIN=            # e.g. yourcompany.com — empty = any account
# OAUTH_REDIRECT_URI=http://localhost:8001/auth/callback
# OAUTH_FRONTEND_URL=http://localhost:3001
# JWT_SECRET=                      # generate with: openssl rand -hex 32

# ── Anonymous telemetry ───────────────────────────────────────────────────────
# One ping on startup + one per day: random install id, version, OS, provider
# types, bucketed index count. No documents, queries, names, URLs, or keys.
# On by default (see README → Telemetry). To turn it off, uncomment one of:
# TELEMETRY_ENABLED=false
# DO_NOT_TRACK=1
# TELEMETRY_URL=                   # override the built-in collector endpoint
